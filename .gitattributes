# Normalise text files to LF in the repository.
* text=auto

# Files used inside Linux containers / CI must keep LF line endings everywhere.
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf

# Never alter these bytes (test fixtures, images).
*.pdf binary
*.png binary
*.exe binary
