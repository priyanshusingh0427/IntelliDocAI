# Copy this file to .env and change values as needed.
APP_NAME="IntelliDoc AI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
# Comma-separated list of frontend URLs allowed to call the API (React dev server in Phase 5)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
LOG_LEVEL="INFO"
# ---- Phase 2: documents ----
DATABASE_URL="sqlite:///./intellidoc.db"
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=".pdf,.docx,.txt"
MAX_PDF_PAGES=2000

# ---- Phase 3: chunking, embeddings, ChromaDB ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_PROVIDER="sentence-transformers"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR="models"
CHROMA_DIR="chroma_db"
CHROMA_COLLECTION="intellidoc_chunks"
AUTO_INDEX_ON_UPLOAD=true
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=50

# ---- Phase 4: hybrid search, reranking, RAG answers ----
HYBRID_CANDIDATES=20
RRF_K=60
RERANK_CANDIDATES=12
RERANKER_PROVIDER="cross-encoder"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANK_MIN_SCORE=-6.0
# If nothing passes RERANK_MIN_SCORE, use the best chunk found by BOTH keyword and meaning search
# (semantic similarity >= this), and keep the answer only if a sentence is >= 60% source words.
RERANK_FALLBACK_MIN_SEMANTIC=0.25
LOW_CONFIDENCE_MIN_SUPPORT=0.6
RAG_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_CHARS=6000
# transformers (in-process, default) | ollama (needs Ollama installed) | extractive (no LLM)
LLM_PROVIDER="transformers"
LLM_MODEL="Qwen/Qwen2.5-0.5B-Instruct"
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
LLM_MAX_NEW_TOKENS=300
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=4096

# ---- Phase 6: PostgreSQL, users, login, chat history ----
# PostgreSQL instead of SQLite (needs the psycopg driver from requirements.txt):
# DATABASE_URL="postgresql+psycopg://intellidoc:PASSWORD@127.0.0.1:5432/intellidoc"
# Signs login tokens: use a long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_REGISTRATION=true
PASSWORD_MIN_LENGTH=8
# The first account adopts documents uploaded before accounts existed
ADOPT_UNOWNED_DOCUMENTS=true
