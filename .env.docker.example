# Settings for `docker compose` (copy to .env in this folder; .env is never committed).
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

# Required. Use letters and digits only (it is placed inside a database URL).
POSTGRES_PASSWORD=
# Required. Signs login tokens; changing it logs everyone out.
SECRET_KEY=

# "ollama" (default, needs ~3 GB RAM for llama3.2:3b) or "extractive" (no LLM: answers are
# the best passages with citations, works on small servers).
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b

# Port on this machine, and the address people use to open the app.
PUBLIC_PORT=8080
PUBLIC_URL=http://localhost:8080

# Set to false after creating your account to stop strangers registering.
ALLOW_REGISTRATION=true
LOG_LEVEL=INFO
